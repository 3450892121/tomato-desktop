# 依赖与构建产物
node_modules
dist
build
out
app/node_modules
app/release
app/dist

# 本机构建工具（Node 便携版等）
.tools

# 打包用外部小工具（rcedit 等，二进制，按需下载）
app/build

# 软件运行期用户数据（绿色版配置随文件夹走，不进 git）
app/userdata

# LibreOffice 可选加装包（体积数百 MB，不进 git；放置位置见 spec/modules/pdf-convert.md）
app/addons

# 日志与系统文件
*.log
.DS_Store
Thumbs.db
desktop.ini

# 环境与本地配置
.env
.env.*
*.local
# 测试证据（截图等，不进 git）
artifacts

# 编辑器/AI 工具的本地工作目录（计划文档等，不进 git；结论性内容已落到 spec/）
.trae
# Qoder 自动生成的 Repo Wiki 与本地配置，换机可重建，不入库
.qoder/

# Mimosa 安全扫描工具的本地状态（钩子缓存等，不进 git）
.mimosa/
app/.mimosa/

# 本地私人笔记目录：不入库（AGENTS.md「隐私防漏」）
/notes/

开源发布/
*.7z
*.zip
